# AI Growth and Commerce Agent - Environment Variables
# Copy this to .env and fill in your values

# Database
# Production (Render): DATABASE_URL is provided automatically via render.yaml
# Local dev: Falls back to SQLite if DATABASE_URL is not set
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Razorpay (test mode by default)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook (optional)
RAZORPAY_WEBHOOK_SECRET=

# CORS (comma-separated origins, or leave empty for all)
ALLOWED_ORIGINS=
