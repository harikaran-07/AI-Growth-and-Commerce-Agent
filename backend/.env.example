# MerchantFlow AI - Environment Variables
# Copy this to .env and fill in your values

# Database (Render provides this automatically)
DATABASE_URL=sqlite+aiosqlite:///./merchantflow.db

# AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Gemini API Keys (dual-key failover)
# Key 1 is tried first. If quota/rate-limited, Key 2 is used automatically.
# Get keys from: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Fallback key name (used by old code, maps to Key 1)
GEMINI_API_KEY=

# Razorpay (test mode by default)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook (optional)
RAZORPAY_WEBHOOK_SECRET=

# CORS (comma-separated origins, or leave empty for all)
ALLOWED_ORIGINS=
